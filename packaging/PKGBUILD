# libfprint with an additional driver for the ZKSoftware ZK4500 (1b55:0840).
# Based on the Arch Linux libfprint PKGBUILD (Jan Alexander Steffens et al.).

pkgname=libfprint-zk4500
_pkgname=libfprint
pkgver=1.94.100
pkgrel=1
pkgdesc="Library for fingerprint readers (with ZKSoftware ZK4500 driver)"
url="https://fprint.freedesktop.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  meson
  python-cairo
  python-gobject
  systemd
)
provides=("libfprint=$pkgver" libfprint-2.so)
conflicts=(libfprint)
groups=(fprint)
source=("git+https://gitlab.freedesktop.org/libfprint/libfprint.git#tag=v$pkgver"
        zk4500.c)
b2sums=('SKIP'
        'SKIP')

prepare() {
  cd $_pkgname
  cp "$srcdir/zk4500.c" libfprint/drivers/zk4500.c
  # register the driver (sources + driver list)
  sed -i "s|^    'vcom5s' : files('drivers/vcom5s.c'),$|&\n    'zk4500' : files('drivers/zk4500.c'),|" libfprint/meson.build
  sed -i "s|^    'vcom5s': {},$|&\n    'zk4500': {},|" meson.build
  grep -q "'zk4500' : files" libfprint/meson.build
  grep -q "'zk4500': {}" meson.build
}

build() {
  local meson_options=(
    -D drivers=all
    -D doc=false
    -D installed-tests=false
  )

  arch-meson $_pkgname build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
